# ─────────────────────────────────────────────
# DocMind — Environment Variables Template
# Copy this file to .env and fill in real values:
#   cp .env.example .env
# ─────────────────────────────────────────────

# ─── LLM Provider Keys ───
# You only need ONE of these. Groq is recommended (free + fast).
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Default LLM provider: groq | openai | anthropic
LLM_PROVIDER=groq
LLM_MODEL=llama-3.1-8b-instant

# ─── LangFuse Observability ───
# Sign up free at https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ─── Embeddings ───
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ─── Chunking ───
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# ─── Vector Store ───
VECTOR_STORE_PATH=./data/faiss_index

# ─── App Config ───
LOG_LEVEL=INFO
MAX_AGENT_ITERATIONS=2